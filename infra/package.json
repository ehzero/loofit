{
  "name": "@loofit/infra",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run build && npm test",
    "synth": "cdk synth --quiet --no-validation",
    "diff": "cdk diff LoofitProductionData LoofitProductionService",
    "deploy": "cdk deploy --all --require-approval broadening"
  },
  "dependencies": {
    "aws-cdk-lib": "2.263.0",
    "constructs": "10.8.1"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "aws-cdk": "2.1135.0",
    "tsx": "4.23.8",
    "typescript": "~6.0.3",
    "vitest": "4.1.10"
  }
}
