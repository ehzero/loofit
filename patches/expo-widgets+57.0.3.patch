+  private static func startLiveActivity(title: String, startedAt: String) async {
+    guard #available(iOS 16.2, *),
+          ActivityAuthorizationInfo().areActivitiesEnabled,
+          Activity<LiveActivityAttributes>.activities.isEmpty else {
+      return
+    }
+
+    let props: [String: Any] = [
+      "title": title,
+      "subtitle": "Loofit 운동 중",
+      "startedAt": startedAt
+    ]
+    guard let data = try? JSONSerialization.data(withJSONObject: props),
+          let propsString = String(data: data, encoding: .utf8) else {
+      return
+    }
+
+    do {
+      _ = try Activity.request(
+        attributes: LiveActivityAttributes(),
+        content: ActivityContent(
+          state: LiveActivityAttributes.ContentState(name: liveActivityName, props: propsString),
+          staleDate: nil
+        ),
+        pushType: nil
+      )
+    } catch {
+      print("[Loofit] Failed to start widget Live Activity: \(error.localizedDescription)")
+    }
+  }
+
+  private static func endLiveActivities() async {
+    guard #available(iOS 16.2, *) else {
+      return
+    }
+
+    for activity in Activity<LiveActivityAttributes>.activities {
+      await activity.end(nil, dismissalPolicy: .immediate)
+    }
+  }
