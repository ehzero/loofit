+  private static func fetchActiveSession(_ db: OpaquePointer) -> ActiveSession? {
+    guard let statement = prepare(
+      db,
+      """
+      SELECT id, routine_id, routine_day_id, started_at
+      FROM workout_sessions
+      WHERE status = 'active'
+      ORDER BY started_at DESC, id DESC
+      LIMIT 1
+      """
+    ) else {
+      return nil
+    }
+    defer { sqlite3_finalize(statement) }
+
+    guard sqlite3_step(statement) == SQLITE_ROW else {
+      return nil
+    }
+
+    let id = sqlite3_column_int64(statement, 0)
+    let startedAt = columnString(statement, 3) ?? isoString(Date())
+    return ActiveSession(
+      id: id,
+      routineId: columnInt64(statement, 1),
+      routineDayId: columnInt64(statement, 2),
+      startedAt: startedAt,
+      title: fetchSessionTitle(db, sessionId: id)
+    )
+  }
+
+  private static func fetchSessionTitle(_ db: OpaquePointer, sessionId: Int64) -> String {
+    let names = fetchStrings(
+      db,
+      """
+      SELECT body_part_name
+      FROM workout_session_parts_snapshot
+      WHERE workout_session_id = ?
+      ORDER BY sort_order ASC, id ASC
+      """,
+      [.int(sessionId)]
+    )
+    return joinPartNames(names)
+  }
+
+  private static func fetchActiveRoutineId(_ db: OpaquePointer) -> Int64? {
+    fetchInt64(
+      db,
+      "SELECT id FROM routines WHERE is_active = 1 ORDER BY id DESC LIMIT 1"
+    )
+  }
+
+  private static func fetchNextRoutineDay(
+    _ db: OpaquePointer,
+    activeRoutineId: Int64
+  ) -> RoutineDay? {
+    let nextRoutineDayId = fetchInt64(
+      db,
+      "SELECT next_routine_day_id FROM routine_progress WHERE id = 1"
+    )
+    if let nextRoutineDayId,
+       let day = fetchRoutineDay(db, routineDayId: nextRoutineDayId),
+       day.routineId == activeRoutineId {
+      return day
+    }
+
+    guard let firstDayId = fetchInt64(
+      db,
+      "SELECT id FROM routine_days WHERE routine_id = ? ORDER BY sort_order ASC, id ASC LIMIT 1",
+      [.int(activeRoutineId)]
+    ) else {
+      return nil
+    }
+    return fetchRoutineDay(db, routineDayId: firstDayId)
+  }
+
+  private static func fetchRoutineDay(_ db: OpaquePointer, routineDayId: Int64) -> RoutineDay? {
+    guard let statement = prepare(
+      db,
+      """
+      SELECT id, routine_id, name, sort_order
+      FROM routine_days
+      WHERE id = ?
+      LIMIT 1
+      """,
+      [.int(routineDayId)]
+    ) else {
+      return nil
+    }
+    defer { sqlite3_finalize(statement) }
+
+    guard sqlite3_step(statement) == SQLITE_ROW else {
+      return nil
+    }
+
+    return RoutineDay(
+      id: sqlite3_column_int64(statement, 0),
+      routineId: sqlite3_column_int64(statement, 1),
+      name: columnString(statement, 2) ?? "추천 운동",
+      sortOrder: Int(sqlite3_column_int64(statement, 3))
+    )
+  }
+
+  private static func fetchRoutineDayParts(
+    _ db: OpaquePointer,
+    routineDayId: Int64
+  ) -> [RoutinePart] {
+    guard let statement = prepare(
+      db,
+      """
+      SELECT bp.id, bp.name, bp.color, rdp.sort_order
+      FROM routine_day_parts rdp
+      JOIN body_parts bp ON bp.id = rdp.body_part_id
+      WHERE rdp.routine_day_id = ?
+      ORDER BY rdp.sort_order ASC, rdp.id ASC
+      """,
+      [.int(routineDayId)]
+    ) else {
+      return []
+    }
+    defer { sqlite3_finalize(statement) }
+
+    var parts: [RoutinePart] = []
+    while sqlite3_step(statement) == SQLITE_ROW {
+      parts.append(
+        RoutinePart(
+          id: sqlite3_column_int64(statement, 0),
+          name: columnString(statement, 1) ?? "운동",
+          color: columnString(statement, 2) ?? "#6C757D",
+          sortOrder: Int(sqlite3_column_int64(statement, 3))
+        )
+      )
+    }
+    return parts
+  }
+
+  private static func fetchRoutineDayAfterCompletion(
+    _ db: OpaquePointer,
+    routineId: Int64,
+    completedRoutineDayId: Int64
+  ) -> Int64? {
+    let ids = fetchInt64s(
+      db,
+      "SELECT id FROM routine_days WHERE routine_id = ? ORDER BY sort_order ASC, id ASC",
+      [.int(routineId)]
+    )
+    guard !ids.isEmpty else {
+      return nil
+    }
+    guard let completedIndex = ids.firstIndex(of: completedRoutineDayId) else {
+      return ids[0]
+    }
+    return ids[(completedIndex + 1) % ids.count]
+  }
+
+  private static func upsertRoutineProgress(
+    _ db: OpaquePointer,
+    activeRoutineId: Int64?,
+    nextRoutineDayId: Int64?,
+    updatedAt: String
+  ) -> Bool {
+    execute(
+      db,
+      """
+      INSERT INTO routine_progress (id, active_routine_id, next_routine_day_id, updated_at)
+      VALUES (1, ?, ?, ?)
+      ON CONFLICT(id) DO UPDATE SET
+        active_routine_id = excluded.active_routine_id,
+        next_routine_day_id = excluded.next_routine_day_id,
+        updated_at = excluded.updated_at
+      """,
+      [.nullableInt(activeRoutineId), .nullableInt(nextRoutineDayId), .text(updatedAt)]
+    )
+  }
