+  private static func workoutDisplayTitleAndDetail(
+    _ db: OpaquePointer,
+    routineDayId: Int64?,
+    partsTitle: String
+  ) -> WorkoutDisplay {
+    guard let routineDayId,
+          let routineDay = fetchRoutineDay(db, routineDayId: routineDayId) else {
+      return WorkoutDisplay(title: partsTitle, detail: "")
+    }
+
+    let alias = routineDay.name.trimmingCharacters(in: .whitespacesAndNewlines)
+    guard !alias.isEmpty, alias != partsTitle else {
+      return WorkoutDisplay(title: partsTitle, detail: "")
+    }
+
+    return WorkoutDisplay(title: alias, detail: partsTitle)
+  }
