+  private static func buildHeatmapDays(
+    _ db: OpaquePointer,
+    days: Int,
+    now: Date
+  ) -> [[String: Any]] {
+    let calendar = Calendar.current
+    let today = calendar.startOfDay(for: now)
+    var totals: [String: Int] = [:]
+    let earliest = calendar.date(byAdding: .day, value: -(days - 1), to: today) ?? today
+
+    guard let statement = prepare(
+      db,
+      """
+      SELECT started_at, duration_seconds
+      FROM workout_sessions
+      WHERE status = 'completed'
+      """
+    ) else {
+      return []
+    }
+    defer { sqlite3_finalize(statement) }
+
+    while sqlite3_step(statement) == SQLITE_ROW {
+      guard let startedAt = columnString(statement, 0),
+            let startedDate = parseISODate(startedAt),
+            startedDate >= earliest,
+            startedDate <= now else {
+        continue
+      }
+      let key = localDateKey(startedDate)
+      totals[key, default: 0] += Int(sqlite3_column_int64(statement, 1))
+    }
+
+    return (0..<days).compactMap { index in
+      guard let date = calendar.date(byAdding: .day, value: index - days + 1, to: today) else {
+        return nil
+      }
+      let key = localDateKey(date)
+      let duration = totals[key, default: 0]
+      return [
+        "dateKey": key,
+        "durationSeconds": duration,
+        "bucket": heatmapBucket(duration)
+      ]
+    }
+  }
+
+  private static func buildHeatmapGrid(
+    _ db: OpaquePointer,
+    days: Int,
+    now: Date
+  ) -> [[String: Any]] {
+    let calendar = Calendar.current
+    let today = calendar.startOfDay(for: now)
+    let rangeStart = calendar.date(byAdding: .day, value: -(days - 1), to: today) ?? today
+    let leadingCellCount = max(calendar.component(.weekday, from: rangeStart) - 1, 0)
+    let rangeCells = buildHeatmapDays(db, days: days, now: now)
+
+    guard leadingCellCount > 0 else {
+      return rangeCells
+    }
+
+    let leadingCells: [[String: Any]] = (0..<leadingCellCount).compactMap { index in
+      guard let date = calendar.date(byAdding: .day, value: index - leadingCellCount, to: rangeStart) else {
+        return nil
+      }
+      return [
+        "dateKey": localDateKey(date),
+        "durationSeconds": 0,
+        "bucket": 0
+      ]
+    }
+
+    return leadingCells + rangeCells
+  }
+
+  private static func buildRecentMonthHeatmapGrid(
+    _ db: OpaquePointer,
+    months: Int,
+    now: Date
+  ) -> [[String: Any]] {
+    let calendar = Calendar.current
+    let today = calendar.startOfDay(for: now)
+    let components = calendar.dateComponents([.year, .month], from: today)
+    let currentMonthStart = calendar.date(
+      from: DateComponents(year: components.year, month: components.month, day: 1)
+    ) ?? today
+    let rangeStart = calendar.date(
+      byAdding: .month,
+      value: -(max(months, 1) - 1),
+      to: currentMonthStart
+    ) ?? currentMonthStart
+    let leadingCellCount = max(calendar.component(.weekday, from: rangeStart) - 1, 0)
+    let gridStart = calendar.date(byAdding: .day, value: -leadingCellCount, to: rangeStart) ?? rangeStart
+    let dayCount = max((calendar.dateComponents([.day], from: gridStart, to: today).day ?? 0) + 1, 1)
+
+    return buildHeatmapDays(db, days: dayCount, now: now)
+  }
+
+  private static func buildWeekHeatmapFooter(
+    _ db: OpaquePointer,
+    now: Date,
+    stats: CompletedRangeStats,
+    since: Date
+  ) -> HeatmapFooter {
+    let recent = fetchRecentCompletedWorkouts(db, since: since, now: now)
+
+    return HeatmapFooter(
+      statLabels: ["총 시간", "평균"],
+      statValues: [
+        formatDuration(stats.durationSeconds),
+        formatDuration(averageDurationSeconds(stats))
+      ],
+      recentLabel: "최근 운동",
+      recentTitles: recent.map { "\($0.title) · \(formatDuration($0.durationSeconds))" },
+      recentMetas: recent.map { relativeWorkoutDayLabel($0.startedAt, now: now) }
+    )
+  }
+
+  private static func heatmapWidgetTitle(_ label: String, count: Int) -> String {
+    "\(label) · \(count)회"
+  }
+
+  private static func averageDurationSeconds(_ stats: CompletedRangeStats) -> Int {
+    stats.count > 0 ? Int((Double(stats.durationSeconds) / Double(stats.count)).rounded()) : 0
+  }
+
+  private static func fetchCompletedRangeStats(
+    _ db: OpaquePointer,
+    since: Date
+  ) -> CompletedRangeStats {
+    guard let statement = prepare(
+      db,
+      """
+      SELECT COUNT(*) AS count, SUM(duration_seconds) AS total
+      FROM workout_sessions
+      WHERE status = 'completed' AND started_at >= ?
+      """,
+      [.text(isoString(since))]
+    ) else {
+      return CompletedRangeStats(count: 0, durationSeconds: 0)
+    }
+    defer { sqlite3_finalize(statement) }
+
+    guard sqlite3_step(statement) == SQLITE_ROW else {
+      return CompletedRangeStats(count: 0, durationSeconds: 0)
+    }
+
+    return CompletedRangeStats(
+      count: Int(sqlite3_column_int64(statement, 0)),
+      durationSeconds: Int(sqlite3_column_int64(statement, 1))
+    )
+  }
+
+  private static func fetchRecentCompletedWorkouts(
+    _ db: OpaquePointer,
+    since: Date,
+    now: Date
+  ) -> [RecentWorkout] {
+    guard let statement = prepare(
+      db,
+      """
+      SELECT id, routine_day_id, started_at, duration_seconds
+      FROM workout_sessions
+      WHERE status = 'completed' AND started_at >= ?
+      ORDER BY started_at DESC, id DESC
+      LIMIT 2
+      """,
+      [.text(isoString(since))]
+    ) else {
+      return []
+    }
+    defer { sqlite3_finalize(statement) }
+
+    var records: [RecentWorkout] = []
+    while sqlite3_step(statement) == SQLITE_ROW {
+      let sessionId = sqlite3_column_int64(statement, 0)
+      let routineDayId = columnInt64(statement, 1)
+      guard let startedAtString = columnString(statement, 2),
+            let startedAt = parseISODate(startedAtString),
+            startedAt <= now else {
+        continue
+      }
+
+      records.append(
+        RecentWorkout(
+          title: fetchWorkoutRecordTitle(db, sessionId: sessionId, routineDayId: routineDayId),
+          startedAt: startedAt,
+          durationSeconds: Int(sqlite3_column_int64(statement, 3))
+        )
+      )
+    }
+    return records
+  }
+
+  private static func fetchWorkoutRecordTitle(
+    _ db: OpaquePointer,
+    sessionId: Int64,
+    routineDayId: Int64?
+  ) -> String {
+    if let routineDayId,
+       let routineDay = fetchRoutineDay(db, routineDayId: routineDayId) {
+      let alias = routineDay.name.trimmingCharacters(in: .whitespacesAndNewlines)
+      if !alias.isEmpty {
+        return alias
+      }
+    }
+
+    let names = fetchStrings(
+      db,
+      """
+      SELECT body_part_name
+      FROM workout_session_parts_snapshot
+      WHERE workout_session_id = ?
+      ORDER BY sort_order ASC, id ASC
+      """,
+      [.int(sessionId)]
+    )
+    return names.isEmpty ? "자유 운동" : names.joined(separator: " · ")
+  }
+
+  private static func relativeWorkoutDayLabel(_ startedAt: Date, now: Date) -> String {
+    let calendar = Calendar.current
+    let today = calendar.startOfDay(for: now)
+    let startedDay = calendar.startOfDay(for: startedAt)
+    let diffDays = max(0, calendar.dateComponents([.day], from: startedDay, to: today).day ?? 0)
+
+    if diffDays == 0 {
+      return "오늘"
+    }
+    if diffDays == 1 {
+      return "어제"
+    }
+    return "\(diffDays)일 전"
+  }
+
+  private static func buildHeatmapWidgetProps(
+    title: String,
+    cells: [[String: Any]],
+    variant: HeatmapWidgetVariant,
+    theme: WidgetTheme,
+    footer: HeatmapFooter?
+  ) -> [String: Any] {
+    let spec = heatmapWidgetSpec(for: variant)
+    let renderCells = variant == .year ? insertMonthTransitionGapCells(cells) : cells
+    let monthMetadata: WeekMonthMetadata
+    if variant == .year {
+      monthMetadata = buildWeekMonthMetadata(renderCells)
+    } else {
+      monthMetadata = WeekMonthMetadata(labels: [], gapBeforeWeeks: [])
+    }
+
+    return [
+      "title": title,
+      "colors": renderCells.map { cell in
+        heatmapCellColor(cell, theme: theme)
+      }.joined(separator: ","),
+      "labels": renderCells.map { cell in
+        isGapCell(cell) ? "" : dayOfMonthLabel(cell["dateKey"] as? String)
+      }.joined(separator: ","),
+      "labelColors": renderCells.map { cell in
+        isGapCell(cell) ? theme.heatmapDayLabelColor : heatmapLabelColor(bucket: intValue(cell["bucket"]), theme: theme)
+      }.joined(separator: ","),
+      "weekdayLabels": heatmapWeekdayLabels,
+      "monthLabels": monthMetadata.labels.joined(separator: ","),
+      "monthGapBeforeWeeks": monthMetadata.gapBeforeWeeks.joined(separator: ","),
+      "brandName": defaultBrandName,
+      "footerStatLabels": footer?.statLabels.joined(separator: ",") ?? "",
+      "footerStatValues": footer?.statValues.joined(separator: ",") ?? "",
+      "recentWorkoutLabel": footer?.recentLabel ?? "",
+      "recentWorkoutTitles": footer?.recentTitles.joined(separator: ",") ?? "",
+      "recentWorkoutMetas": footer?.recentMetas.joined(separator: ",") ?? "",
+      "background": theme.heatmapBackground,
+      "titleColor": theme.heatmapTitleColor,
+      "brandColor": theme.heatmapBrandColor,
+      "footerValueColor": theme.heatmapFooterValueColor,
+      "weekdayLabelColor": theme.heatmapWeekdayLabelColor,
+      "titleSize": 11,
+      "brandSize": 10,
+      "weekdayLabelSize": 8,
+      "monthLabelSize": 9,
+      "cellLabelSize": spec.cellLabelSize,
+      "contentPadding": 16,
+      "cellGap": spec.cellGap,
+      "cellRadius": spec.cellRadius,
+      "headerGap": spec.headerGap,
+      "columns": spec.columns,
+      "monthGapColumns": spec.monthGapColumns
+    ]
+  }
+
+  private static func insertMonthTransitionGapCells(_ cells: [[String: Any]]) -> [[String: Any]] {
+    var result: [[String: Any]] = []
+    var hasSeenFirstMonth = false
+
+    for cell in cells {
+      let isMonthStart = (
+        !isGapCell(cell)
+          && dayFromDateKey(cell["dateKey"] as? String ?? "") == 1
+      )
+
+      if isMonthStart {
+        if hasSeenFirstMonth {
+          result.append(contentsOf: monthTransitionGapCells())
+        } else {
+          hasSeenFirstMonth = true
+        }
+      }
+
+      result.append(cell)
+    }
+
+    return result
+  }
+
+  private static func monthTransitionGapCells() -> [[String: Any]] {
+    (0..<7).map { _ in
+      [
+        "dateKey": "",
+        "durationSeconds": 0,
+        "bucket": 0,
+        "isGap": true
+      ]
+    }
+  }
+
+  private static func buildWeekMonthMetadata(_ cells: [[String: Any]]) -> WeekMonthMetadata {
+    let weekCount = Int(ceil(Double(cells.count) / 7.0))
+    var labels = Array(repeating: "", count: weekCount)
+    var gapBeforeWeeks = Array(repeating: "0", count: weekCount)
+
+    for week in 0..<weekCount {
+      let start = week * 7
+      let end = min(start + 7, cells.count)
+      guard start < end else {
+        continue
+      }
+
+      for index in start..<end {
+        guard !isGapCell(cells[index]),
+              let dateKey = cells[index]["dateKey"] as? String,
+              dayFromDateKey(dateKey) == 1,
+              let month = monthFromDateKey(dateKey) else {
+          continue
+        }
+        let dayIndex = index - start
+        let labelWeek = dayIndex == 0 || week + 1 >= weekCount ? week : week + 1
+        labels[labelWeek] = "\(month)월"
+        break
+      }
+    }
+
+    return WeekMonthMetadata(labels: labels, gapBeforeWeeks: gapBeforeWeeks)
+  }
+
+  private static func heatmapWidgetSpec(for variant: HeatmapWidgetVariant) -> HeatmapWidgetSpec {
+    switch variant {
+    case .week:
+      return HeatmapWidgetSpec(cellGap: 4, cellRadius: 4, headerGap: 8, columns: 7, cellLabelSize: 8, monthGapColumns: 0)
+    case .month:
+      return HeatmapWidgetSpec(cellGap: 3, cellRadius: 3, headerGap: 8, columns: 7, cellLabelSize: 7, monthGapColumns: 0)
+    case .year:
+      return HeatmapWidgetSpec(cellGap: 2, cellRadius: 2, headerGap: 8, columns: 0, cellLabelSize: 0, monthGapColumns: 0)
+    }
+  }
+
+  private static func heatmapColor(bucket: Int, theme: WidgetTheme) -> String {
+    switch bucket {
+    case 1:
+      return mixHex(theme.accent, theme.heatmapBaseColor, weight: 0.24)
+    case 2:
+      return mixHex(theme.accent, theme.heatmapBaseColor, weight: 0.48)
+    case 3:
+      return mixHex(theme.accent, theme.heatmapBaseColor, weight: 0.74)
+    case 4:
+      return theme.accent
+    default:
+      return theme.heatmapEmptyColor
+    }
+  }
+
+  private static func heatmapCellColor(_ cell: [String: Any], theme: WidgetTheme) -> String {
+    isGapCell(cell) ? theme.heatmapGapColor : heatmapColor(bucket: intValue(cell["bucket"]), theme: theme)
+  }
+
+  private static func heatmapLabelColor(bucket: Int, theme: WidgetTheme) -> String {
+    if bucket >= 3 {
+      return theme.accentText
+    }
+    return theme.heatmapDayLabelColor
+  }
+
+  private static func isGapCell(_ cell: [String: Any]) -> Bool {
+    boolValue(cell["isGap"])
+  }
+
+  private static func boolValue(_ value: Any?) -> Bool {
+    if let value = value as? Bool {
+      return value
+    }
+    if let value = value as? NSNumber {
+      return value.boolValue
+    }
+    if let value = value as? String {
+      return value == "1" || value.lowercased() == "true"
+    }
+    return false
+  }
+
+  private static func dayOfMonthLabel(_ dateKey: String?) -> String {
+    guard let day = dateKey?.split(separator: "-").last,
+          let dayNumber = Int(day) else {
+      return ""
+    }
+    return "\(dayNumber)"
+  }
+
+  private static func monthFromDateKey(_ dateKey: String) -> Int? {
+    let components = dateKey.split(separator: "-")
+    guard components.count >= 2 else {
+      return nil
+    }
+    return Int(components[1])
+  }
+
+  private static func dayFromDateKey(_ dateKey: String) -> Int? {
+    let components = dateKey.split(separator: "-")
+    guard components.count >= 3 else {
+      return nil
+    }
+    return Int(components[2])
+  }
+
+  private static func accentTextColor(_ accent: String) -> String {
+    guard let rgb = parseHex(accent) else {
+      return "#0B0B0B"
+    }
+    let brightness = (0.299 * rgb.red + 0.587 * rgb.green + 0.114 * rgb.blue) / 255
+    return brightness > 0.62 ? "#0B0B0B" : "#FFFFFF"
+  }
+
+  private static func mixHex(_ a: String, _ b: String, weight: Double) -> String {
+    guard let ca = parseHex(a),
+          let cb = parseHex(b) else {
+      return a
+    }
+
+    return hexString(
+      red: ca.red * weight + cb.red * (1 - weight),
+      green: ca.green * weight + cb.green * (1 - weight),
+      blue: ca.blue * weight + cb.blue * (1 - weight)
+    )
+  }
+
+  private static func parseHex(_ value: String) -> RGB? {
+    let hex = value
+      .trimmingCharacters(in: .whitespacesAndNewlines)
+      .replacingOccurrences(of: "#", with: "")
+
+    guard hex.count >= 6 else {
+      return nil
+    }
+
+    var integer: UInt64 = 0
+    guard Scanner(string: String(hex.prefix(6))).scanHexInt64(&integer) else {
+      return nil
+    }
+
+    return RGB(
+      red: Double((integer >> 16) & 0xFF),
+      green: Double((integer >> 8) & 0xFF),
+      blue: Double(integer & 0xFF)
+    )
+  }
+
+  private static func hexString(red: Double, green: Double, blue: Double) -> String {
+    let red = Int(round(max(0, min(255, red))))
+    let green = Int(round(max(0, min(255, green))))
+    let blue = Int(round(max(0, min(255, blue))))
+    return String(format: "#%02x%02x%02x", red, green, blue)
+  }
+
+  private static func intValue(_ value: Any?) -> Int {
+    if let value = value as? Int {
+      return value
+    }
+    if let value = value as? Int64 {
+      return Int(value)
+    }
+    if let value = value as? NSNumber {
+      return value.intValue
+    }
+    if let value = value as? String, let number = Int(value) {
+      return number
+    }
+    return 0
+  }
+
+  private static func nonEmptyString(_ value: Any?) -> String? {
+    guard let string = value as? String else {
+      return nil
+    }
+    let trimmed = string.trimmingCharacters(in: .whitespacesAndNewlines)
+    return trimmed.isEmpty ? nil : string
+  }
