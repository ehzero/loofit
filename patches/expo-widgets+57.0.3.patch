+  private static func syncHeatmapWidgets(theme: WidgetTheme) {
+    guard let payload = withDatabase({ db -> HeatmapWidgetPayload? in
+      let now = Date()
+      let calendar = Calendar.current
+      let today = calendar.startOfDay(for: now)
+      let weekSince = calendar.date(byAdding: .day, value: -6, to: today) ?? today
+      let monthSince = calendar.date(byAdding: .day, value: -29, to: today) ?? today
+      let currentMonthStart = calendar.date(
+        from: calendar.dateComponents([.year, .month], from: today)
+      ) ?? today
+      let sixMonthSince = calendar.date(
+        byAdding: .month,
+        value: -(heatmapRecentMonthCount - 1),
+        to: currentMonthStart
+      ) ?? currentMonthStart
+      let weekStats = fetchCompletedRangeStats(db, since: weekSince)
+      let monthStats = fetchCompletedRangeStats(db, since: monthSince)
+      let sixMonthStats = fetchCompletedRangeStats(db, since: sixMonthSince)
+      return HeatmapWidgetPayload(
+        week: buildHeatmapWidgetProps(
+          title: heatmapWidgetTitle("지난 7일", count: weekStats.count),
+          cells: buildHeatmapDays(db, days: 7, now: now),
+          variant: .week,
+          theme: theme,
+          footer: buildWeekHeatmapFooter(db, now: now, stats: weekStats, since: weekSince)
+        ),
+        month: buildHeatmapWidgetProps(
+          title: heatmapWidgetTitle("지난 30일", count: monthStats.count),
+          cells: buildHeatmapGrid(db, days: 30, now: now),
+          variant: .month,
+          theme: theme,
+          footer: nil
+        ),
+        year: buildHeatmapWidgetProps(
+          title: heatmapWidgetTitle("지난 6개월", count: sixMonthStats.count),
+          cells: buildRecentMonthHeatmapGrid(db, months: heatmapRecentMonthCount, now: now),
+          variant: .year,
+          theme: theme,
+          footer: nil
+        )
+      )
+    }) else {
+      return
+    }
+
+    updateHeatmapTimeline(kind: heatmapWeekWidgetName, props: payload.week)
+    updateHeatmapTimeline(kind: heatmapMonthWidgetName, props: payload.month)
+    updateHeatmapTimeline(kind: heatmapYearWidgetName, props: payload.year)
+  }
