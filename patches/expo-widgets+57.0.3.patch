+  private static func withDatabase<T>(_ body: (OpaquePointer) -> T?) -> T? {
+    guard let groupIdentifier = WidgetsStorage.appGroupIdentifier,
+          let containerUrl = FileManager.default.containerURL(
+            forSecurityApplicationGroupIdentifier: groupIdentifier
+          ) else {
+      return nil
+    }
+
+    let directoryUrl = containerUrl.appendingPathComponent("ExpoWidgets", isDirectory: true)
+    do {
+      try FileManager.default.createDirectory(at: directoryUrl, withIntermediateDirectories: true)
+    } catch {
+      print("[Loofit] Failed to create widget database directory: \(error.localizedDescription)")
+      return nil
+    }
+
+    let databaseUrl = directoryUrl.appendingPathComponent(databaseName, isDirectory: false)
+    var db: OpaquePointer?
+    guard sqlite3_open(databaseUrl.path, &db) == SQLITE_OK, let db else {
+      print("[Loofit] Failed to open widget database")
+      return nil
+    }
+    defer { sqlite3_close(db) }
+
+    return body(db)
+  }
