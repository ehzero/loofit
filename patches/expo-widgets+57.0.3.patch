+  private static func startRecommendedWorkout() -> StartedWorkout? {
+    withDatabase { db in
+      guard execute(db, "PRAGMA busy_timeout = 5000"),
+            execute(db, "BEGIN IMMEDIATE") else {
+        return nil
+      }
+
+      if let active = fetchActiveSession(db) {
+        execute(db, "ROLLBACK")
+        return StartedWorkout(title: active.title, startedAt: active.startedAt)
+      }
+
+      guard let routineId = fetchActiveRoutineId(db),
+            let routineDay = fetchNextRoutineDay(db, activeRoutineId: routineId) else {
+        execute(db, "ROLLBACK")
+        return nil
+      }
+
+      let parts = fetchRoutineDayParts(db, routineDayId: routineDay.id)
+      guard !parts.isEmpty else {
+        execute(db, "ROLLBACK")
+        return nil
+      }
+
+      let now = Date()
+      let nowString = isoString(now)
+      guard execute(
+        db,
+        """
+        INSERT INTO workout_sessions
+          (routine_id, routine_day_id, started_at, ended_at, duration_seconds, status, note, created_at, updated_at)
+        VALUES (?, ?, ?, NULL, 0, 'active', NULL, ?, ?)
+        """,
+        [.int(routineId), .int(routineDay.id), .text(nowString), .text(nowString), .text(nowString)]
+      ) else {
+        execute(db, "ROLLBACK")
+        return nil
+      }
+
+      let sessionId = sqlite3_last_insert_rowid(db)
+      for part in parts {
+        guard execute(
+          db,
+          """
+          INSERT INTO workout_session_parts_snapshot
+            (workout_session_id, body_part_id, body_part_name, body_part_color, sort_order)
+          VALUES (?, ?, ?, ?, ?)
+          """,
+          [.int(sessionId), .int(part.id), .text(part.name), .text(part.color), .int(Int64(part.sortOrder))]
+        ) else {
+          execute(db, "ROLLBACK")
+          return nil
+        }
+      }
+
+      guard execute(db, "COMMIT") else {
+        execute(db, "ROLLBACK")
+        return nil
+      }
+
+      let partsTitle = joinPartNames(parts.map(\.name))
+      let display = workoutDisplayTitleAndDetail(
+        db,
+        routineDayId: routineDay.id,
+        partsTitle: partsTitle
+      )
+
+      return StartedWorkout(title: display.title, startedAt: nowString)
+    }
+  }
+
+  private static func completeActiveWorkout() -> CompletedWorkout? {
+    withDatabase { db in
+      guard execute(db, "PRAGMA busy_timeout = 5000"),
+            execute(db, "BEGIN IMMEDIATE") else {
+        return nil
+      }
+
+      guard let active = fetchActiveSession(db) else {
+        execute(db, "ROLLBACK")
+        return nil
+      }
+
+      let now = Date()
+      let duration = max(0, Int(now.timeIntervalSince(parseISODate(active.startedAt) ?? now)))
+      let nowString = isoString(now)
+
+      guard execute(
+        db,
+        """
+        UPDATE workout_sessions
+        SET status = 'completed', ended_at = ?, duration_seconds = ?, updated_at = ?
+        WHERE id = ? AND status = 'active'
+        """,
+        [.text(nowString), .int(Int64(duration)), .text(nowString), .int(active.id)]
+      ) else {
+        execute(db, "ROLLBACK")
+        return nil
+      }
+
+      if let completedRoutineDayId = active.routineDayId {
+        let activeRoutineId = fetchActiveRoutineId(db)
+        let nextRoutineDayId = activeRoutineId.flatMap {
+          fetchRoutineDayAfterCompletion(
+            db,
+            routineId: $0,
+            completedRoutineDayId: completedRoutineDayId
+          )
+        }
+        guard upsertRoutineProgress(
+          db,
+          activeRoutineId: activeRoutineId,
+          nextRoutineDayId: nextRoutineDayId,
+          updatedAt: nowString
+        ) else {
+          execute(db, "ROLLBACK")
+          return nil
+        }
+      }
+
+      guard execute(db, "COMMIT") else {
+        execute(db, "ROLLBACK")
+        return nil
+      }
+
+      let display = workoutDisplayTitleAndDetail(
+        db,
+        routineDayId: active.routineDayId,
+        partsTitle: active.title
+      )
+
+      return CompletedWorkout(
+        title: display.title,
+        detail: display.detail,
+        durationSeconds: duration,
+        completedAt: now
+      )
+    }
+  }
