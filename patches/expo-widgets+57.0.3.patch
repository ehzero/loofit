+  static func handleWorkoutControlAction(
+    target: String?,
+    timeline: [[String: Any]],
+    entryIndex: Int
+  ) async -> [[String: Any]] {
+    guard let target else {
+      return timeline
+    }
+
+    let theme = fetchWidgetTheme(fallbackProps: timelineProps(timeline, entryIndex: entryIndex))
+
+    switch target {
+    case startTarget:
+      guard let result = startRecommendedWorkout() else {
+        return timeline
+      }
+      await startLiveActivity(title: result.title, startedAt: result.startedAt, theme: theme)
+      syncWorkoutLockScreenWidgetAfterStart(result: result, theme: theme)
+      return timelineAfterStart(timeline, entryIndex: entryIndex, result: result, theme: theme)
+
+    case endTarget:
+      guard let result = completeActiveWorkout() else {
+        return timeline
+      }
+      syncHeatmapWidgets(theme: theme)
+      syncWorkoutLockScreenWidgetAfterCompletion(result: result, theme: theme)
+      syncWorkoutLockScreenSummaryWidget(theme: theme)
+      await endLiveActivities()
+      return timelineAfterCompletion(timeline, entryIndex: entryIndex, result: result, theme: theme)
+
+    default:
+      return timeline
+    }
+  }
