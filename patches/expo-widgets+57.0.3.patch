+    updateHeatmapTimeline(kind: heatmapWeekWidgetName, props: payload.week)
+    updateHeatmapTimeline(kind: heatmapMonthWidgetName, props: payload.month)
+    updateHeatmapTimeline(kind: heatmapYearWidgetName, props: payload.year)
