+private enum LoofitWidgetActions {
+  private static let databaseName = "loofit.db"
+  private static let heatmapWeekWidgetName = "HeatmapWeekWidget"
+  private static let heatmapMonthWidgetName = "HeatmapMonthWidget"
+  private static let heatmapYearWidgetName = "HeatmapYearWidget"
+  private static let liveActivityName = "WorkoutLiveActivity"
+  private static let startTarget = "start-recommended"
+  private static let endTarget = "end-active"
+  private static let defaultAccent = "#CFF56A"
+  private static let heatmapBaseColor = "#16161A"
+  private static let heatmapEmptyColor = "#1B1B1F"
+  private static let sqliteTransient = unsafeBitCast(
