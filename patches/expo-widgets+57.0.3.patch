+  private static func buildHeatmapDays(
+    _ db: OpaquePointer,
+    days: Int,
+    now: Date
+  ) -> [[String: Any]] {
+    let calendar = Calendar.current
+    let today = calendar.startOfDay(for: now)
+    var totals: [String: Int] = [:]
+    let earliest = calendar.date(byAdding: .day, value: -(days - 1), to: today) ?? today
+
+    guard let statement = prepare(
+      db,
+      """
+      SELECT started_at, duration_seconds
+      FROM workout_sessions
+      WHERE status = 'completed'
+      """
+    ) else {
+      return []
+    }
+    defer { sqlite3_finalize(statement) }
+
+    while sqlite3_step(statement) == SQLITE_ROW {
+      guard let startedAt = columnString(statement, 0),
+            let startedDate = parseISODate(startedAt),
+            startedDate >= earliest,
+            startedDate <= now else {
+        continue
+      }
+      let key = localDateKey(startedDate)
+      totals[key, default: 0] += Int(sqlite3_column_int64(statement, 1))
+    }
+
+    return (0..<days).compactMap { index in
+      guard let date = calendar.date(byAdding: .day, value: index - days + 1, to: today) else {
+        return nil
+      }
+      let key = localDateKey(date)
+      let duration = totals[key, default: 0]
+      return [
+        "dateKey": key,
+        "durationSeconds": duration,
+        "bucket": heatmapBucket(duration)
+      ]
+    }
+  }
+
+  private static func buildHeatmapGrid(
+    _ db: OpaquePointer,
+    days: Int,
+    now: Date
+  ) -> [[String: Any]] {
+    let calendar = Calendar.current
+    let today = calendar.startOfDay(for: now)
+    let rangeStart = calendar.date(byAdding: .day, value: -(days - 1), to: today) ?? today
+    let leadingCellCount = max(calendar.component(.weekday, from: rangeStart) - 1, 0)
+    let rangeCells = buildHeatmapDays(db, days: days, now: now)
+
+    guard leadingCellCount > 0 else {
+      return rangeCells
+    }
+
+    let leadingCells: [[String: Any]] = (0..<leadingCellCount).compactMap { index in
+      guard let date = calendar.date(byAdding: .day, value: index - leadingCellCount, to: rangeStart) else {
+        return nil
+      }
+      return [
+        "dateKey": localDateKey(date),
+        "durationSeconds": 0,
+        "bucket": 0
+      ]
+    }
+
+    return leadingCells + rangeCells
+  }
+
+  private static func buildHeatmapWidgetProps(
+    cells: [[String: Any]],
+    variant: HeatmapWidgetVariant,
+    accent: String
+  ) -> [String: Any] {
+    let spec = heatmapWidgetSpec(for: variant)
+    return [
+      "colors": cells.map { cell in
+        heatmapColor(bucket: intValue(cell["bucket"]), accent: accent)
+      }.joined(separator: ","),
+      "background": "#141418",
+      "titleColor": "#8A8A90",
+      "brandColor": "#6B6B70",
+      "titleSize": 11,
+      "brandSize": 10,
+      "contentPadding": 16,
+      "cellGap": spec.cellGap,
+      "cellRadius": spec.cellRadius,
+      "headerGap": spec.headerGap,
+      "columns": spec.columns
+    ]
+  }
+
+  private static func heatmapWidgetSpec(for variant: HeatmapWidgetVariant) -> HeatmapWidgetSpec {
+    switch variant {
+    case .week:
+      return HeatmapWidgetSpec(cellGap: 4, cellRadius: 4, headerGap: 12, columns: 7)
+    case .month:
+      return HeatmapWidgetSpec(cellGap: 3, cellRadius: 3, headerGap: 12, columns: 7)
+    case .year:
+      return HeatmapWidgetSpec(cellGap: 1.5, cellRadius: 1, headerGap: 8, columns: 0)
+    }
+  }
+
+  private static func heatmapColor(bucket: Int, accent: String) -> String {
+    switch bucket {
+    case 1:
+      return mixHex(accent, heatmapBaseColor, weight: 0.24)
+    case 2:
+      return mixHex(accent, heatmapBaseColor, weight: 0.48)
+    case 3:
+      return mixHex(accent, heatmapBaseColor, weight: 0.74)
+    case 4:
+      return accent
+    default:
+      return heatmapEmptyColor
+    }
+  }
+
+  private static func mixHex(_ a: String, _ b: String, weight: Double) -> String {
+    guard let ca = parseHex(a),
+          let cb = parseHex(b) else {
+      return a
+    }
+
+    return hexString(
+      red: ca.red * weight + cb.red * (1 - weight),
+      green: ca.green * weight + cb.green * (1 - weight),
+      blue: ca.blue * weight + cb.blue * (1 - weight)
+    )
+  }
+
+  private static func parseHex(_ value: String) -> RGB? {
+    let hex = value
+      .trimmingCharacters(in: .whitespacesAndNewlines)
+      .replacingOccurrences(of: "#", with: "")
+
+    guard hex.count >= 6 else {
+      return nil
+    }
+
+    var integer: UInt64 = 0
+    guard Scanner(string: String(hex.prefix(6))).scanHexInt64(&integer) else {
+      return nil
+    }
+
+    return RGB(
+      red: Double((integer >> 16) & 0xFF),
+      green: Double((integer >> 8) & 0xFF),
+      blue: Double(integer & 0xFF)
+    )
+  }
+
+  private static func hexString(red: Double, green: Double, blue: Double) -> String {
+    let red = Int(round(max(0, min(255, red))))
+    let green = Int(round(max(0, min(255, green))))
+    let blue = Int(round(max(0, min(255, blue))))
+    return String(format: "#%02x%02x%02x", red, green, blue)
+  }
+
+  private static func intValue(_ value: Any?) -> Int {
+    if let value = value as? Int {
+      return value
+    }
+    if let value = value as? Int64 {
+      return Int(value)
+    }
+    if let value = value as? NSNumber {
+      return value.intValue
+    }
+    if let value = value as? String, let number = Int(value) {
+      return number
+    }
+    return 0
+  }
+
+  private static func prepare(
+    _ db: OpaquePointer,
+    _ sql: String,
+    _ values: [SQLiteValue] = []
+  ) -> OpaquePointer? {
+    var statement: OpaquePointer?
+    guard sqlite3_prepare_v2(db, sql, -1, &statement, nil) == SQLITE_OK, let statement else {
+      print("[Loofit] Failed to prepare SQL: \(sql)")
+      return nil
+    }
+    for (index, value) in values.enumerated() {
+      bind(value, to: statement, at: Int32(index + 1))
+    }
+    return statement
+  }
+
+  private static func execute(
+    _ db: OpaquePointer,
+    _ sql: String,
+    _ values: [SQLiteValue] = []
+  ) -> Bool {
+    guard let statement = prepare(db, sql, values) else {
+      return false
+    }
+    defer { sqlite3_finalize(statement) }
+
+    let result = sqlite3_step(statement)
+    if result == SQLITE_DONE || result == SQLITE_ROW {
+      return true
+    }
+    print("[Loofit] Failed to execute SQL: \(sql)")
+    return false
+  }
+
+  private static func fetchInt64(
+    _ db: OpaquePointer,
+    _ sql: String,
+    _ values: [SQLiteValue] = []
+  ) -> Int64? {
+    guard let statement = prepare(db, sql, values) else {
+      return nil
+    }
+    defer { sqlite3_finalize(statement) }
+
+    guard sqlite3_step(statement) == SQLITE_ROW else {
+      return nil
+    }
+    return columnInt64(statement, 0)
+  }
+
+  private static func fetchInt64s(
+    _ db: OpaquePointer,
+    _ sql: String,
+    _ values: [SQLiteValue] = []
+  ) -> [Int64] {
+    guard let statement = prepare(db, sql, values) else {
+      return []
+    }
+    defer { sqlite3_finalize(statement) }
+
+    var values: [Int64] = []
+    while sqlite3_step(statement) == SQLITE_ROW {
+      if let value = columnInt64(statement, 0) {
+        values.append(value)
+      }
+    }
+    return values
+  }
+
+  private static func fetchStrings(
+    _ db: OpaquePointer,
+    _ sql: String,
+    _ values: [SQLiteValue] = []
+  ) -> [String] {
+    guard let statement = prepare(db, sql, values) else {
+      return []
+    }
+    defer { sqlite3_finalize(statement) }
+
+    var values: [String] = []
+    while sqlite3_step(statement) == SQLITE_ROW {
+      if let value = columnString(statement, 0) {
+        values.append(value)
+      }
+    }
+    return values
+  }
+
+  private static func bind(_ value: SQLiteValue, to statement: OpaquePointer, at index: Int32) {
+    switch value {
+    case .int(let value):
+      sqlite3_bind_int64(statement, index, value)
+    case .nullableInt(let value):
+      if let value {
+        sqlite3_bind_int64(statement, index, value)
+      } else {
+        sqlite3_bind_null(statement, index)
+      }
+    case .text(let value):
+      sqlite3_bind_text(statement, index, value, -1, sqliteTransient)
+    case .null:
+      sqlite3_bind_null(statement, index)
+    }
+  }
+
+  private static func columnString(_ statement: OpaquePointer, _ index: Int32) -> String? {
+    guard sqlite3_column_type(statement, index) != SQLITE_NULL,
+          let text = sqlite3_column_text(statement, index) else {
+      return nil
+    }
+    return String(cString: text)
+  }
+
+  private static func columnInt64(_ statement: OpaquePointer, _ index: Int32) -> Int64? {
+    guard sqlite3_column_type(statement, index) != SQLITE_NULL else {
+      return nil
+    }
+    return sqlite3_column_int64(statement, index)
+  }
