+  private static func timelineAfterStart(
+    _ timeline: [[String: Any]],
+    entryIndex: Int,
+    result: StartedWorkout
+  ) -> [[String: Any]] {
+    var updatedTimeline = timeline
+    guard updatedTimeline.indices.contains(entryIndex) else {
+      return timeline
+    }
+    updatedTimeline[entryIndex] = [
+      "timestamp": currentTimestamp(),
+      "props": [
+        "state": "active",
+        "title": result.title,
+        "subtitle": "운동 중",
+        "durationLabel": "진행 중",
+        "startedAt": result.startedAt
+      ]
+    ]
+    return [updatedTimeline[entryIndex]]
+  }
+
+  private static func timelineAfterCompletion(
+    _ timeline: [[String: Any]],
+    entryIndex: Int,
+    result: CompletedWorkout
+  ) -> [[String: Any]] {
+    var updatedTimeline = timeline
+    guard updatedTimeline.indices.contains(entryIndex) else {
+      return timeline
+    }
+
+    updatedTimeline[entryIndex] = [
+      "timestamp": currentTimestamp(),
+      "props": [
+        "state": "completed",
+        "title": result.title,
+        "subtitle": "오늘 운동 완료",
+        "durationLabel": formatDuration(result.durationSeconds)
+      ]
+    ]
+
+    let tomorrowEntry: [String: Any] = [
+      "timestamp": timestamp(for: startOfTomorrow(from: result.completedAt)),
+      "props": idleProps()
+    ]
+
+    if updatedTimeline.count > entryIndex + 1 {
+      updatedTimeline[entryIndex + 1] = tomorrowEntry
+    } else {
+      updatedTimeline.append(tomorrowEntry)
+    }
+
+    return updatedTimeline
+  }
