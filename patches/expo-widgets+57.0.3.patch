+  private static func timelineAfterCompletion(
+    _ timeline: [[String: Any]],
+    entryIndex: Int,
+    result: CompletedWorkout,
+    theme: WidgetTheme
+  ) -> [[String: Any]] {
+    var updatedTimeline = timeline
+    guard updatedTimeline.indices.contains(entryIndex) else {
+      return timeline
+    }
+
+    let props = controlWidgetProps(theme: theme, stateProps: [
+      "state": "completed",
+      "title": result.title,
+      "detail": result.detail,
+      "subtitle": "오늘 운동 완료",
+      "durationLabel": formatDuration(result.durationSeconds)
+    ])
+    updatedTimeline[entryIndex] = [
