+  private static func fetchActiveSession(_ db: OpaquePointer) -> ActiveSession? {
+    guard let statement = prepare(
+      db,
+      """
+      SELECT id, routine_id, routine_day_id, started_at
+      FROM workout_sessions
+      WHERE status = 'active'
+      ORDER BY started_at DESC, id DESC
+      LIMIT 1
+      """
+    ) else {
+      return nil
+    }
+    defer { sqlite3_finalize(statement) }
+
+    guard sqlite3_step(statement) == SQLITE_ROW else {
+      return nil
+    }
+
+    let id = sqlite3_column_int64(statement, 0)
+    let startedAt = columnString(statement, 3) ?? isoString(Date())
+    let routineDayId = columnInt64(statement, 2)
+    let partsTitle = fetchSessionTitle(db, sessionId: id)
+    let display = workoutDisplayTitleAndDetail(
+      db,
+      routineDayId: routineDayId,
+      partsTitle: partsTitle
+    )
+    return ActiveSession(
+      id: id,
+      routineId: columnInt64(statement, 1),
+      routineDayId: routineDayId,
+      startedAt: startedAt,
+      title: display.title
+    )
+  }
