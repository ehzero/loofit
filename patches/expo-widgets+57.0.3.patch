+  static func handleLiveActivityAction(target: String?) async {
+    guard target == endTarget else {
+      return
+    }
+
+    let timelineKey = "__expo_widgets_\(workoutControlWidgetName)_timeline"
+    let timeline = WidgetsStorage.getArray(forKey: timelineKey) as? [[String: Any]] ?? []
+    let fallbackProps = (timeline.first?["props"] as? [String: Any]) ?? [:]
+    let theme = fetchWidgetTheme(fallbackProps: fallbackProps)
+
+    guard let result = completeActiveWorkout() else {
+      await endLiveActivities()
+      return
+    }
+
+    syncHeatmapWidgets(theme: theme)
+    syncWorkoutLockScreenWidgetAfterCompletion(result: result, theme: theme)
+    syncWorkoutLockScreenSummaryWidget(theme: theme)
+    let baseTimeline: [[String: Any]]
+    if timeline.isEmpty {
+      baseTimeline = [["timestamp": currentTimestamp(), "props": fallbackProps]]
+    } else {
+      baseTimeline = timeline
+    }
+    let updatedTimeline = timelineAfterCompletion(
+      baseTimeline,
+      entryIndex: 0,
