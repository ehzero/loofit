{
  "version": 1,
  "seed": {
    "routineId": 10,
    "nextRoutineDayId": 101,
    "bodyParts": [
      { "id": 1, "name": "가슴", "color": "#E84A5F", "sortOrder": 0 },
      { "id": 2, "name": "등", "color": "#2A9D8F", "sortOrder": 1 },
      { "id": 3, "name": "하체", "color": "#F4A261", "sortOrder": 2 }
    ],
    "routineDays": [
      { "id": 101, "name": "Push", "sortOrder": 0, "bodyPartIds": [1] },
      { "id": 102, "name": "Pull", "sortOrder": 1, "bodyPartIds": [2] }
    ]
  },
  "scenarios": [
    {
      "id": "routine-complete-and-duplicate",
      "steps": [
        {
          "command": { "type": "startNext" },
          "captureSessionAs": "routine",
          "expect": { "status": "applied", "sessionId": "nonNull" }
        },
        {
          "command": { "type": "complete", "expectedSessionId": { "ref": "routine" } },
          "expect": { "status": "applied", "sessionId": { "ref": "routine" } }
        },
        {
          "command": { "type": "complete", "expectedSessionId": { "ref": "routine" } },
          "expect": { "status": "noop", "sessionId": null }
        }
      ],
      "expectState": {
        "activeSessionCount": 0,
        "nextRoutineDayId": 102,
        "sessions": [
          { "ref": "routine", "status": "completed", "routineDayId": 101, "parts": ["가슴"] }
        ]
      }
    },
    {
      "id": "active-noop-stale-and-rejected",
      "steps": [
        {
          "command": { "type": "startRoutine", "routineDayId": 101 },
          "captureSessionAs": "active",
          "expect": { "status": "applied", "sessionId": "nonNull" }
        },
        {
          "command": { "type": "startRoutine", "routineDayId": 102 },
          "expect": { "status": "noop", "sessionId": { "ref": "active" } }
        },
        {
          "command": {
            "type": "changeParts",
            "expectedSessionId": { "ref": "active", "offset": 999 },
            "bodyPartIds": [3],
            "updateRoutine": false
          },
          "expect": { "status": "stale", "sessionId": { "ref": "active" } }
        },
        {
          "command": {
            "type": "changeParts",
            "expectedSessionId": { "ref": "active" },
            "bodyPartIds": [999],
            "updateRoutine": false
          },
          "expect": { "status": "rejected", "sessionId": { "ref": "active" } }
        },
        {
          "command": {
            "type": "complete",
            "expectedSessionId": { "ref": "active", "offset": 999 }
          },
          "expect": { "status": "stale", "sessionId": { "ref": "active" } }
        },
        {
          "command": { "type": "cancel", "expectedSessionId": { "ref": "active" } },
          "expect": { "status": "applied", "sessionId": { "ref": "active" } }
        }
      ],
      "expectState": {
        "activeSessionCount": 0,
        "nextRoutineDayId": 101,
        "sessions": [
          { "ref": "active", "status": "canceled", "routineDayId": 101, "parts": ["가슴"] }
        ]
      }
    },
    {
      "id": "one-time-part-edit-keeps-routine-default",
      "steps": [
        {
          "command": { "type": "startRoutine", "routineDayId": 101 },
          "captureSessionAs": "editedOnce",
          "expect": { "status": "applied", "sessionId": "nonNull" }
        },
        {
          "command": {
            "type": "changeParts",
            "expectedSessionId": { "ref": "editedOnce" },
            "bodyPartIds": [3],
            "updateRoutine": false
          },
          "expect": { "status": "applied", "sessionId": { "ref": "editedOnce" } }
        },
        {
          "command": { "type": "complete", "expectedSessionId": { "ref": "editedOnce" } },
          "expect": { "status": "applied", "sessionId": { "ref": "editedOnce" } }
        },
        {
          "command": { "type": "startRoutine", "routineDayId": 101 },
          "captureSessionAs": "futureOnce",
          "expect": { "status": "applied", "sessionId": "nonNull" }
        },
        {
          "command": { "type": "cancel", "expectedSessionId": { "ref": "futureOnce" } },
          "expect": { "status": "applied", "sessionId": { "ref": "futureOnce" } }
        }
      ],
      "expectState": {
        "activeSessionCount": 0,
        "nextRoutineDayId": 102,
        "sessions": [
          { "ref": "editedOnce", "status": "completed", "routineDayId": 101, "parts": ["하체"] },
          { "ref": "futureOnce", "status": "canceled", "routineDayId": 101, "parts": ["가슴"] }
        ]
      }
    },
    {
      "id": "routine-part-edit-updates-future-workouts",
      "steps": [
        {
          "command": { "type": "startRoutine", "routineDayId": 101 },
          "captureSessionAs": "editedRoutine",
          "expect": { "status": "applied", "sessionId": "nonNull" }
        },
        {
          "command": {
            "type": "changeParts",
            "expectedSessionId": { "ref": "editedRoutine" },
            "bodyPartIds": [3],
            "updateRoutine": true
          },
          "expect": { "status": "applied", "sessionId": { "ref": "editedRoutine" } }
        },
        {
          "command": { "type": "complete", "expectedSessionId": { "ref": "editedRoutine" } },
          "expect": { "status": "applied", "sessionId": { "ref": "editedRoutine" } }
        },
        {
          "command": { "type": "startRoutine", "routineDayId": 101 },
          "captureSessionAs": "futureRoutine",
          "expect": { "status": "applied", "sessionId": "nonNull" }
        },
        {
          "command": { "type": "cancel", "expectedSessionId": { "ref": "futureRoutine" } },
          "expect": { "status": "applied", "sessionId": { "ref": "futureRoutine" } }
        }
      ],
      "expectState": {
        "activeSessionCount": 0,
        "nextRoutineDayId": 102,
        "sessions": [
          { "ref": "editedRoutine", "status": "completed", "routineDayId": 101, "parts": ["하체"] },
          { "ref": "futureRoutine", "status": "canceled", "routineDayId": 101, "parts": ["하체"] }
        ]
      }
    },
    {
      "id": "cancel-and-duplicate-cancel",
      "steps": [
        {
          "command": { "type": "startRoutine", "routineDayId": 101 },
          "captureSessionAs": "canceled",
          "expect": { "status": "applied", "sessionId": "nonNull" }
        },
        {
          "command": { "type": "cancel", "expectedSessionId": { "ref": "canceled" } },
          "expect": { "status": "applied", "sessionId": { "ref": "canceled" } }
        },
        {
          "command": { "type": "cancel", "expectedSessionId": { "ref": "canceled" } },
          "expect": { "status": "noop", "sessionId": null }
        }
      ],
      "expectState": {
        "activeSessionCount": 0,
        "nextRoutineDayId": 101,
        "sessions": [
          { "ref": "canceled", "status": "canceled", "routineDayId": 101, "parts": ["가슴"] }
        ]
      }
    },
    {
      "id": "invalid-routine-start-is-rejected",
      "steps": [
        {
          "command": { "type": "startRoutine", "routineDayId": 999 },
          "expect": { "status": "rejected", "sessionId": null }
        }
      ],
      "expectState": {
        "activeSessionCount": 0,
        "nextRoutineDayId": 101,
        "sessions": []
      }
    }
  ]
}
