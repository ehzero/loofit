      "version": 3,
      "afterSqlIsIdempotent": true,
      "afterSql": [
        "UPDATE workout_sessions",
        "SET routine_day_name_snapshot = COALESCE(",
        "  NULLIF(TRIM((",
        "    SELECT rd.name",
        "    FROM routine_days rd",
        "    WHERE rd.id = workout_sessions.routine_day_id",
        "    LIMIT 1",
        "  )), ''),",
        "  NULLIF((",
        "    SELECT GROUP_CONCAT(ordered_parts.body_part_name, ' · ')",
        "    FROM (",
        "      SELECT sp.body_part_name",
        "      FROM workout_session_parts_snapshot sp",
        "      WHERE sp.workout_session_id = workout_sessions.id",
        "      ORDER BY sp.sort_order ASC, sp.id ASC",
        "    ) AS ordered_parts",
        "  ), ''),",
        "  '삭제된 분할'",
        ")",
        "WHERE routine_day_id IS NOT NULL",
        "  AND routine_day_name_snapshot IS NULL;"
      ]
    }
