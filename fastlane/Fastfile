default_platform(:ios)

def app_store_connect_key
  required = %w[ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_FILEPATH]
  missing = required.select { |name| ENV[name].to_s.empty? }

  UI.user_error!("Missing App Store Connect credentials: #{missing.join(', ')}") unless missing.empty?
  UI.user_error!("ASC_KEY_FILEPATH does not exist") unless File.file?(ENV.fetch("ASC_KEY_FILEPATH"))

  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_filepath: ENV.fetch("ASC_KEY_FILEPATH"),
    in_house: false
  )
end

def ensure_screenshots!
  path = File.expand_path("screenshots", __dir__)
  screenshots = Dir.glob(File.join(path, "**", "*.{png,jpg,jpeg}"), File::FNM_CASEFOLD)
  UI.user_error!("No App Store screenshots found under #{path}") if screenshots.empty?
end

def store_delivery_options
  version = ENV["APP_STORE_VERSION"]
  UI.user_error!("APP_STORE_VERSION is required") if version.to_s.empty?

  {
    api_key: app_store_connect_key,
    app_version: version,
    skip_binary_upload: true,
    submit_for_review: false
  }
end

platform :ios do
  desc "Upload localized App Store metadata without screenshots or a binary"
  lane :store_metadata do
    deliver(**store_delivery_options.merge(skip_screenshots: true))
  end

  desc "Upload App Store screenshots without metadata or a binary"
  lane :store_screenshots do
    ensure_screenshots!
    deliver(**store_delivery_options.merge(skip_metadata: true))
  end

  desc "Upload App Store metadata, screenshots, and optional preview videos"
  lane :store_listing do
    ensure_screenshots!
    deliver(**store_delivery_options)
  end
end
