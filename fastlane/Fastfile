default_platform(:ios)
skip_docs

# deliver 2.237.0 fetches App Review details even when no review attachment is
# configured. A first App Store version has no review-detail resource yet, so
# that unconditional fetch ends the otherwise successful metadata upload with
# `No data`. Preserve remote review attachments unless this repo explicitly
# provides a replacement file.
require "deliver/upload_metadata"

module PreserveUnmanagedAppReviewAttachment
  def review_attachment_file(version)
    return unless options[:app_review_attachment_file]

    super
  end
end

Deliver::UploadMetadata.prepend(PreserveUnmanagedAppReviewAttachment)

def app_store_connect_key
  required = %w[ASC_KEY_ID ASC_KEY_FILEPATH]
  missing = required.select { |name| ENV[name].to_s.empty? }

  UI.user_error!("Missing App Store Connect credentials: #{missing.join(', ')}") unless missing.empty?
  UI.user_error!("ASC_KEY_FILEPATH does not exist") unless File.file?(ENV.fetch("ASC_KEY_FILEPATH"))

  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV["ASC_ISSUER_ID"].to_s.empty? ? nil : ENV["ASC_ISSUER_ID"],
    key_filepath: ENV.fetch("ASC_KEY_FILEPATH"),
    in_house: false
  )
end

def ensure_screenshots!
  path = File.expand_path("screenshots", __dir__)
  screenshots = Dir.glob(File.join(path, "**", "*.{png,jpg,jpeg}"), File::FNM_CASEFOLD)
  UI.user_error!("No App Store screenshots found under #{path}") if screenshots.empty?
end

def play_store_json_key
  key_path = ENV["PLAY_STORE_JSON_KEY"]
  UI.user_error!("PLAY_STORE_JSON_KEY is required") if key_path.to_s.empty?
  UI.user_error!("PLAY_STORE_JSON_KEY does not exist") unless File.file?(key_path)

  key_path
end

def ensure_play_screenshots!
  path = File.expand_path("metadata/android", __dir__)
  screenshots = Dir.glob(
    File.join(path, "**", "images", "phoneScreenshots", "*.{png,jpg,jpeg}"),
    File::FNM_CASEFOLD
  )
  UI.user_error!("No Google Play phone screenshots found under #{path}") if screenshots.empty?
end

def ensure_play_listing_graphics!
  images_path = File.expand_path("metadata/android/ko-KR/images", __dir__)
  required = %w[icon.png featureGraphic.png]
  missing = required.reject { |name| File.file?(File.join(images_path, name)) }
  UI.user_error!("Missing Google Play listing graphics: #{missing.join(', ')}") unless missing.empty?
end

def play_store_delivery_options
  {
    package_name: ENV.fetch("PLAY_STORE_PACKAGE_NAME", "com.loofit.app"),
    json_key: play_store_json_key,
    metadata_path: File.expand_path("metadata/android", __dir__),
    skip_upload_apk: true,
    skip_upload_aab: true,
    skip_upload_changelogs: true
  }
end

def store_delivery_options
  version = ENV["APP_STORE_VERSION"]
  UI.user_error!("APP_STORE_VERSION is required") if version.to_s.empty?

  {
    api_key: app_store_connect_key,
    app_version: version,
    skip_binary_upload: true,
    submit_for_review: false
  }
end

def store_review_options
  build_number = ENV["APP_STORE_BUILD_NUMBER"]
  UI.user_error!("APP_STORE_BUILD_NUMBER is required") if build_number.to_s.empty?

  store_delivery_options.merge(
    build_number: build_number,
    skip_screenshots: true,
    reject_if_possible: true,
    submit_for_review: true,
    force: true,
    submission_information: {
      export_compliance_uses_encryption: false
    }
  )
end

def testflight_delivery_options
  build_number = ENV["APP_STORE_BUILD_NUMBER"]
  version = ENV["APP_STORE_VERSION"]
  UI.user_error!("APP_STORE_BUILD_NUMBER is required") if build_number.to_s.empty?
  UI.user_error!("APP_STORE_VERSION is required") if version.to_s.empty?

  what_to_test_path = File.expand_path("metadata/testflight/what_to_test.txt", __dir__)
  UI.user_error!("Missing TestFlight What to Test at #{what_to_test_path}") unless File.file?(what_to_test_path)

  {
    api_key: app_store_connect_key,
    app_identifier: ENV.fetch("FASTLANE_APP_IDENTIFIER", "com.loofit.app"),
    app_version: version,
    build_number: build_number,
    distribute_only: true,
    distribute_external: false,
    changelog: File.read(what_to_test_path, encoding: "UTF-8").strip,
    skip_waiting_for_build_processing: false
  }
end

platform :ios do
  desc "Upload localized App Store metadata without screenshots or a binary"
  lane :store_metadata do
    deliver(**store_delivery_options.merge(skip_screenshots: true))
  end

  desc "Upload App Store screenshots without metadata or a binary"
  lane :store_screenshots do
    ensure_screenshots!
    deliver(**store_delivery_options.merge(skip_metadata: true))
  end

  desc "Upload App Store metadata, screenshots, and optional preview videos"
  lane :store_listing do
    ensure_screenshots!
    deliver(**store_delivery_options)
  end

  desc "Wait for an uploaded build, update What to Test, and distribute it to internal testers"
  lane :store_testflight do
    upload_to_testflight(**testflight_delivery_options)
  end

  desc "Replace the submitted build, upload metadata, and submit the EAS build for review"
  lane :store_review do
    deliver(**store_review_options)
  end
end

platform :android do
  desc "Upload localized Google Play metadata without screenshots or a binary"
  lane :play_metadata do
    upload_to_play_store(
      **play_store_delivery_options.merge(
        skip_upload_images: true,
        skip_upload_screenshots: true
      )
    )
  end

  desc "Upload Google Play phone screenshots without metadata or a binary"
  lane :play_screenshots do
    ensure_play_screenshots!
    upload_to_play_store(
      **play_store_delivery_options.merge(
        skip_upload_metadata: true,
        skip_upload_images: true
      )
    )
  end

  desc "Upload Google Play metadata, listing graphics, and phone screenshots without a binary"
  lane :play_listing do
    ensure_play_screenshots!
    ensure_play_listing_graphics!
    upload_to_play_store(
      **play_store_delivery_options
    )
  end
end
