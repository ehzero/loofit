{
  "expo": {
    "name": "Loofit",
    "slug": "loofit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "loofit",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.loofit.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-sqlite",
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.loofit.app.widgets",
          "groupIdentifier": "group.com.loofit.app",
          "widgets": [
            {
              "name": "WorkoutControlWidget",
              "displayName": "Loofit Workout",
              "description": "Start, finish, and review today's workout.",
              "supportedFamilies": ["systemSmall"]
            },
            {
              "name": "HeatmapWeekWidget",
              "displayName": "Loofit Heatmap · 7일",
              "description": "Review your last 7 days of workouts.",
              "contentMarginsDisabled": true,
              "supportedFamilies": ["systemSmall"]
            },
            {
              "name": "HeatmapMonthWidget",
              "displayName": "Loofit Heatmap · 30일",
              "description": "Review your last 30 days of workouts.",
              "contentMarginsDisabled": true,
              "supportedFamilies": ["systemSmall"]
            },
            {
              "name": "HeatmapYearWidget",
              "displayName": "Loofit Heatmap · 1년",
              "description": "Review your last year of workouts.",
              "contentMarginsDisabled": true,
              "supportedFamilies": ["systemMedium"]
            },
            {
              "name": "WorkoutLiveActivity",
              "displayName": "Loofit Live Workout",
              "description": "Track the current workout on the Lock Screen.",
              "supportedFamilies": ["accessoryRectangular", "accessoryInline"]
            }
          ]
        }
      ],
      "./plugins/with-loofit-heatmap-widgets"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
