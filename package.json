{
  "name": "loofit",
  "main": "expo-router/entry",
  "version": "1.0.3",
  "expo": {
    "autolinking": {
      "exclude": [
        "expo-widgets"
      ]
    }
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "expo": "~57.0.4",
    "expo-constants": "~57.0.3",
    "expo-dev-client": "~57.0.5",
    "expo-font": "~57.0.0",
    "expo-linear-gradient": "~57.0.0",
    "expo-linking": "~57.0.2",
    "expo-router": "~57.0.4",
    "expo-splash-screen": "~57.0.2",
    "expo-sqlite": "~57.0.0",
    "expo-status-bar": "~57.0.0",
    "expo-symbols": "~57.0.0",
    "expo-web-browser": "~57.0.0",
    "expo-widgets": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "patch-package": "^8.0.1",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "start": "expo start",
    "showcase": "npm --prefix ./tools/showcase run dev",
    "showcase:install": "npm --prefix ./tools/showcase install",
    "showcase:typecheck": "npm --prefix ./tools/showcase run typecheck",
    "showcase:build": "npm --prefix ./tools/showcase run build",
    "android": "./scripts/build-generated-android.sh",
    "android:build": "./scripts/build-generated-android.sh",
    "android:prebuild": "./scripts/prebuild-android.sh",
    "ios": "./scripts/build-generated-ios.sh",
    "ios:build": "./scripts/build-generated-ios.sh",
    "ios:prebuild:widgets": "./scripts/prebuild-ios-widgets.sh",
    "ios:prebuild:app-only": "./scripts/prebuild-ios-app-only.sh",
    "store:metadata": "bundle exec fastlane ios store_metadata",
    "store:screenshots": "bundle exec fastlane ios store_screenshots",
    "store:listing": "bundle exec fastlane ios store_listing",
    "store:review": "bundle exec fastlane ios store_review",
    "play:metadata": "bundle exec fastlane android play_metadata",
    "play:screenshots": "bundle exec fastlane android play_screenshots",
    "play:listing": "bundle exec fastlane android play_listing",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && npm run contracts:check && npm run lint:tokens",
    "test:command-contract": "vitest run src/db/repositories/workout-command-contract.test.ts",
    "test:ios-core": "./scripts/test-ios-workout-core.sh",
    "test:ios-core:generated": "./scripts/run-generated-ios-core-tests.sh",
    "test:android-core": "./scripts/test-android-workout-core.sh",
    "schema:generate": "node ./scripts/generate-workout-schema.mjs",
    "schema:check": "node ./scripts/generate-workout-schema.mjs --check",
    "generate:widget-contract": "node ./scripts/generate-widget-renderer-contract.mjs",
    "check:widget-contract": "node ./scripts/generate-widget-renderer-contract.mjs --check",
    "contracts:check": "npm run schema:check && npm run check:widget-contract",
    "verify:ios:widgets": "./scripts/verify-widget-extension-isolation.sh",
    "verify:ios:app-only": "./scripts/verify-app-only-ios-project.sh",
    "postinstall": "patch-package",
    "lint:tokens": "./scripts/check-style-tokens.sh"
  },
  "private": true
}
