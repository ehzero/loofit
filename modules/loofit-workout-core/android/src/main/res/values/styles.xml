<?xml version="1.0" encoding="utf-8"?>
<resources>
  <style name="LoofitWidgetPreviewBrand">
    <item name="android:textColor">@color/loofit_widget_preview_accent</item>
    <item name="android:textSize">10sp</item>
    <item name="android:textStyle">bold</item>
    <item name="android:maxLines">1</item>
  </style>
  <style name="LoofitWidgetPreviewLabel">
    <item name="android:textColor">@color/loofit_widget_preview_text_low</item>
    <item name="android:textSize">10sp</item>
    <item name="android:maxLines">1</item>
  </style>
  <style name="LoofitWidgetPreviewTitle">
    <item name="android:textColor">@color/loofit_widget_preview_text</item>
    <item name="android:textSize">18sp</item>
    <item name="android:textStyle">bold</item>
    <item name="android:maxLines">2</item>
  </style>
  <style name="LoofitWidgetPreviewMeta">
    <item name="android:textColor">@color/loofit_widget_preview_text_low</item>
    <item name="android:textSize">10sp</item>
  </style>
  <style name="LoofitWidgetPreviewGrid">
    <item name="android:fontFamily">monospace</item>
    <item name="android:gravity">center</item>
    <item name="android:includeFontPadding">false</item>
    <item name="android:lineSpacingExtra">1dp</item>
    <item name="android:textColor">@color/loofit_widget_preview_accent</item>
    <item name="android:textSize">11sp</item>
  </style>
</resources>
