<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/loofit_widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:padding="12dp"
  android:background="@drawable/loofit_widget_background">

  <TextView
    android:id="@+id/loofit_widget_brand"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxLines="1"
    android:text="루핏"
    android:textSize="10sp" />

  <TextView
    android:id="@+id/loofit_widget_label"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="2dp"
    android:maxLines="1"
    android:text="다음 운동"
    android:textSize="11sp" />

  <TextView
    android:id="@+id/loofit_widget_title"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:layout_marginTop="8dp"
    android:ellipsize="end"
    android:gravity="center_vertical"
    android:maxLines="7"
    android:text="운동"
    android:textSize="18sp"
    android:textStyle="bold" />

  <ImageView
    android:id="@+id/loofit_widget_visual"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:adjustViewBounds="true"
    android:contentDescription="@string/loofit_widget_heatmap_description"
    android:scaleType="fitCenter"
    android:visibility="gone" />

  <Chronometer
    android:id="@+id/loofit_widget_timer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:textColor="#F4F4F2"
    android:textSize="24sp"
    android:textStyle="bold"
    android:visibility="gone" />

  <TextView
    android:id="@+id/loofit_widget_detail"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:ellipsize="end"
    android:maxLines="2"
    android:textSize="11sp" />

  <TextView
    android:id="@+id/loofit_widget_stats"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="3dp"
    android:ellipsize="end"
    android:maxLines="1"
    android:textSize="10sp" />

  <Button
    android:id="@+id/loofit_widget_action"
    android:layout_width="match_parent"
    android:layout_height="40dp"
    android:layout_marginTop="8dp"
    android:minHeight="0dp"
    android:text="운동 시작"
    android:textAllCaps="false"
    android:textSize="12sp"
    android:visibility="gone" />
</LinearLayout>
