<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/loofit_widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent">

  <ImageView
    android:id="@+id/loofit_widget_background_image"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:contentDescription="@null"
    android:scaleType="fitXY" />

  <LinearLayout
    android:id="@+id/loofit_widget_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="16dp"
      android:gravity="center_vertical"
      android:orientation="horizontal">

      <ImageView
        android:id="@+id/loofit_widget_active_dot"
        android:layout_width="7dp"
        android:layout_height="7dp"
        android:layout_marginEnd="8dp"
        android:contentDescription="@null"
        android:src="@drawable/loofit_widget_dot"
        android:visibility="gone" />

      <TextView
        android:id="@+id/loofit_widget_eyebrow"
        android:layout_width="0dp"
        android:layout_height="16dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="sans"
        android:gravity="center_vertical"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textSize="12sp"
        android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1" />

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical">

      <TextView
        android:id="@+id/loofit_widget_title"
        android:layout_width="match_parent"
        android:layout_height="21dp"
        android:ellipsize="end"
        android:fontFamily="sans"
        android:gravity="center_vertical"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textSize="16sp"
        android:textStyle="bold" />

      <Chronometer
        android:id="@+id/loofit_widget_timer"
        android:layout_width="match_parent"
        android:layout_height="31dp"
        android:fontFamily="sans"
        android:gravity="center_vertical"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textSize="26sp"
        android:textStyle="bold"
        android:visibility="gone" />

      <TextView
        android:id="@+id/loofit_widget_detail"
        android:layout_width="match_parent"
        android:layout_height="16dp"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:fontFamily="sans"
        android:gravity="center_vertical"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textSize="12sp"
        android:textStyle="normal" />
    </LinearLayout>

    <FrameLayout
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1" />

    <FrameLayout
      android:id="@+id/loofit_widget_action"
      android:layout_width="match_parent"
      android:layout_height="28dp"
      android:visibility="gone">

      <ImageView
        android:id="@+id/loofit_widget_action_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY" />

      <TextView
        android:id="@+id/loofit_widget_action_label"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fontFamily="sans"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textSize="12sp"
        android:textStyle="bold" />
    </FrameLayout>

    <LinearLayout
      android:id="@+id/loofit_widget_completed_footer"
      android:layout_width="match_parent"
      android:layout_height="49dp"
      android:orientation="vertical"
      android:visibility="gone">

      <TextView
        android:id="@+id/loofit_widget_duration"
        android:layout_width="match_parent"
        android:layout_height="31dp"
        android:ellipsize="end"
        android:fontFamily="sans"
        android:gravity="center_vertical"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textSize="26sp"
        android:textStyle="bold" />

      <TextView
        android:id="@+id/loofit_widget_range"
        android:layout_width="match_parent"
        android:layout_height="16dp"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:fontFamily="sans"
        android:gravity="center_vertical"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textSize="12sp" />
    </LinearLayout>
  </LinearLayout>
</FrameLayout>
