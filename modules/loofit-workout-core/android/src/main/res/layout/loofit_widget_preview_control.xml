<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/loofit_widget_background"
  android:orientation="vertical"
  android:padding="12dp">
  <TextView
    style="@style/LoofitWidgetPreviewBrand"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="루핏" />
  <TextView
    style="@style/LoofitWidgetPreviewLabel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="2dp"
    android:text="다음 운동" />
  <TextView
    style="@style/LoofitWidgetPreviewTitle"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_marginTop="6dp"
    android:layout_weight="1"
    android:gravity="center_vertical"
    android:text="가슴 · 삼두" />
  <TextView
    style="@style/LoofitWidgetPreviewMeta"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:text="Push · 2개 부위" />
  <TextView
    android:layout_width="match_parent"
    android:layout_height="32dp"
    android:background="@drawable/loofit_widget_preview_action"
    android:gravity="center"
    android:text="운동 시작"
    android:textColor="@color/loofit_widget_preview_accent_text"
    android:textSize="11sp"
    android:textStyle="bold" />
</LinearLayout>
