{
  "version": 1,
  "designSystem": {
    "spacing": {
      "xs": 2,
      "sm": 4,
      "md": 8,
      "lg": 12
    },
    "radius": {
      "cell": 3,
      "control": 12,
      "container": 24
    },
    "typography": {
      "sm": { "size": 8, "lineHeight": 10 },
      "md": { "size": 12, "lineHeight": 16 },
      "lg": { "size": 16, "lineHeight": 21 },
      "xl": { "size": 26, "lineHeight": 31 }
    },
    "fontWeight": {
      "bold": "800",
      "medium": "700",
      "light": "600"
    },
    "opacity": {
      "default": 1,
      "muted": 0.72
    },
    "minimumScale": {
      "dense": 0.68,
      "default": 0.75
    },
    "colorRoles": {
      "surface": "card",
      "raisedSurface": "surface2",
      "textHigh": "tx",
      "textMedium": "tx2",
      "textLow": "tx4",
      "textWeekend": "danger",
      "todayIndicator": "todayIndicator",
      "accent": "accent",
      "onAccent": "accentText",
      "heatmapBase": "heatbase",
      "heatmapEmpty": "heat0"
    },
    "contentPadding": "{spacing.lg}"
  },
  "contentMargins": {
    "home": {
      "mode": "proportionalToShortestEdge",
      "referenceShortestEdge": 158
    },
    "accessory": {
      "mode": "systemManaged"
    }
  },
  "card": {
    "screenBackground": "#0C0D10",
    "background": "#141418",
    "border": "rgba(255,255,255,0.08)",
    "radius": "{radius.container}",
    "contentPadding": "{contentPadding}",
    "contentGap": "{spacing.lg}"
  },
  "text": {
    "label": {
      "size": "{typography.md.size}",
      "lineHeight": "{typography.md.lineHeight}",
      "weight": "{fontWeight.bold}"
    },
    "brand": {
      "size": "{typography.sm.size}",
      "lineHeight": "{typography.sm.lineHeight}",
      "weight": "{fontWeight.medium}"
    },
    "calendar": {
      "weekdaySize": "{typography.sm.size}",
      "weekdayLineHeight": "{typography.sm.lineHeight}",
      "weekdayWeight": "{fontWeight.bold}",
      "monthSize": "{typography.sm.size}",
      "monthLineHeight": "{typography.sm.lineHeight}"
    }
  },
  "control": {
    "cardSize": 158,
    "verticalDistribution": "spaceBetween",
    "bodyGap": "{spacing.sm}",
    "activeDotSize": 7,
    "activeDotGap": "{spacing.md}",
    "buttonHeight": 28,
    "buttonRadius": "{radius.control}",
    "footerGap": "{spacing.xs}",
    "timerMaxHours": 8,
    "text": {
      "title": {
        "size": "{typography.lg.size}",
        "lineHeight": "{typography.lg.lineHeight}",
        "weight": "{fontWeight.bold}"
      },
      "timer": {
        "size": "{typography.xl.size}",
        "lineHeight": "{typography.xl.lineHeight}",
        "weight": "{fontWeight.bold}"
      },
      "detail": {
        "size": "{typography.md.size}",
        "lineHeight": "{typography.md.lineHeight}",
        "weight": "{fontWeight.light}"
      },
      "button": {
        "size": "{typography.md.size}",
        "lineHeight": "{typography.md.lineHeight}",
        "weight": "{fontWeight.bold}"
      },
      "duration": {
        "size": "{typography.xl.size}",
        "lineHeight": "{typography.xl.lineHeight}",
        "weight": "{fontWeight.bold}"
      },
      "range": {
        "size": "{typography.md.size}",
        "lineHeight": "{typography.md.lineHeight}",
        "weight": "{fontWeight.light}"
      }
    }
  },
  "routineProgress": {
    "textList": {
      "availability": "native",
      "kindAccessor": "routineProgress",
      "family": "systemSmall",
      "orientation": "vertical",
      "progressBasis": "nextSplitPosition",
      "verticalDistribution": "spaceBetween",
      "visibleItemLimit": 3,
      "visibleItemSelection": "currentCentered",
      "currentTextColorRole": "accent",
      "nonCurrentTextColorRole": "textLow",
      "rowContent": ["split", "relativeDay", "bodyParts", "duration"],
      "metadataSeparator": " · ",
      "emptyRelativeDay": "기록 없음",
      "contentPadding": "{contentPadding}",
      "text": {
        "split": {
          "size": "{typography.xl.size}",
          "lineHeight": "{typography.xl.lineHeight}",
          "weight": "{fontWeight.bold}"
        },
        "metadata": {
          "size": "{typography.sm.size}",
          "lineHeight": "{typography.sm.lineHeight}",
          "weight": "{fontWeight.medium}"
        }
      },
      "lockScreen": {
        "availability": "native",
        "kindAccessor": "lockScreenRoutineProgress",
        "family": "accessoryRectangular",
        "orientation": "horizontal",
        "visibleItemLimit": 3,
        "visibleItemSelection": "currentCentered",
        "progressBasis": "nextSplitPosition",
        "horizontalAlignment": "center",
        "currentTextColorRole": "textHigh",
        "nonCurrentTextColorRole": "textLow",
        "rowContent": ["workoutAliasOrBodyParts", "relativeDay"],
        "contentPadding": "{spacing.sm}",
        "columnGap": "{spacing.sm}",
        "itemGap": "{spacing.xs}",
        "text": {
          "workout": {
            "size": "{typography.lg.size}",
            "lineHeight": "{typography.lg.lineHeight}",
            "weight": "{fontWeight.bold}"
          },
          "relativeDay": {
            "size": "{typography.md.size}",
            "lineHeight": "{typography.md.lineHeight}",
            "weight": "{fontWeight.medium}"
          }
        }
      }
    }
  },
  "bodyPartDuration": {
    "availability": "native",
    "kindAccessor": "bodyPartDuration",
    "family": "systemSmall",
    "rangeDays": 30,
    "durationAttribution": "fullSessionPerBodyPart",
    "sort": "durationDescending",
    "visibleItemLimit": 4,
    "verticalDistribution": "spaceBetween",
    "title": "최근 30일",
    "contentPadding": "{contentPadding}",
    "bar": {
      "height": "{spacing.sm}",
      "radius": "{radius.cell}"
    },
    "text": {
      "title": {
        "size": "{typography.md.size}",
        "lineHeight": "{typography.md.lineHeight}",
        "weight": "{fontWeight.bold}"
      },
      "bodyPart": {
        "size": "{typography.md.size}",
        "lineHeight": "{typography.md.lineHeight}",
        "weight": "{fontWeight.bold}"
      },
      "duration": {
        "size": "{typography.sm.size}",
        "lineHeight": "{typography.sm.lineHeight}",
        "weight": "{fontWeight.medium}"
      }
    }
  },
  "liveActivity": {
    "banner": {
      "minHeight": 104,
      "contentPadding": "{contentPadding}",
      "contentGap": "{spacing.md}",
      "rowGap": "{spacing.sm}",
      "titleFontSize": "{typography.lg.size}",
      "statusFontSize": "{typography.md.size}",
      "timerFontSize": "{typography.xl.size}",
      "buttonWidth": 88,
      "buttonHeight": 32,
      "buttonFontSize": "{typography.md.size}"
    },
    "compact": {
      "leadingWidth": 48,
      "trailingWidth": 48,
      "fontSize": "{typography.md.size}",
      "previewWidth": 230,
      "previewHeight": 37,
      "previewHorizontalPadding": 7
    },
    "minimal": {
      "previewSize": 46,
      "fontSize": "{typography.md.size}"
    },
    "expanded": {
      "regions": {
        "title": "leading",
        "timer": "center",
        "endButton": "trailing"
      },
      "sideRegionVerticalAlignment": "center",
      "timerHorizontalAlignment": "trailing",
      "timerRegionPriority": 1,
      "previewWidth": 371,
      "previewHeight": 84,
      "horizontalPadding": 12,
      "titleWidth": 72,
      "titleFontSize": "{typography.lg.size}",
      "titleMinimumScaleFactor": "{minimumScale.default}",
      "timerFontSize": "{typography.xl.size}",
      "timerLineHeight": "{typography.xl.lineHeight}",
      "buttonWidth": 60,
      "buttonHeight": 26,
      "buttonFontSize": "{typography.md.size}",
      "contentGap": "{spacing.md}"
    }
  },
  "heatmap": {
    "weekdayLabels": ["일", "월", "화", "수", "목", "금", "토"],
    "weekdayLabelHeightInCells": 1,
    "weekdayLabelColorPolicy": {
      "weekendLabels": ["일", "토"],
      "weekendRole": "textWeekend"
    },
    "cellLabelColorPolicy": {
      "empty": "textLow",
      "filled": "textHigh",
      "strongFilled": "onAccent",
      "strongMinimumBucket": 3,
      "strongMinimumDurationSeconds": 3600
    },
    "styles": {
      "detailed": {
        "columns": 7,
        "contentPadding": "{contentPadding}",
        "cellGap": "{spacing.sm}",
        "cellRadius": "{radius.cell}",
        "cellLabelSize": "{typography.sm.size}",
        "headerGap": "{spacing.md}",
        "headerFontSize": "{typography.md.size}"
      },
      "expanded": {
        "columns": 7,
        "contentPadding": "{contentPadding}",
        "cellGap": "{spacing.sm}",
        "cellRadius": "{radius.cell}",
        "cellLabelSize": "{typography.sm.size}",
        "cellLabelLineHeight": "{typography.sm.lineHeight}",
        "bodyPartLabelSize": "{typography.sm.size}",
        "bodyPartLabelLineHeight": "{typography.sm.lineHeight}",
        "bodyPartLabelOpacity": "{opacity.muted}",
        "cellContentGap": "{spacing.xs}",
        "weekdayHeaderHeight": "{typography.sm.lineHeight}",
        "headerGap": "{spacing.sm}",
        "headerFontSize": "{typography.md.size}",
        "aspectRatio": 2.14
      },
      "compact": {
        "columns": 0,
        "contentPadding": "{contentPadding}",
        "cellGap": "{spacing.xs}",
        "cellRadius": "{radius.cell}",
        "cellLabelSize": 0,
        "headerGap": "{spacing.md}",
        "headerFontSize": "{typography.sm.size}"
      }
    },
    "previewVariants": {
      "currentMonth": {
        "style": "detailed",
        "availability": "native",
        "kindAccessor": "currentMonthCalendar",
        "family": "systemSmall",
        "headerVisible": true,
        "headerSummary": "count",
        "maxRows": 6,
        "todayIndicator": {
          "style": "border",
          "colorRole": "todayIndicator",
          "width": 1.5
        }
      },
      "fourWeekExpanded": {
        "style": "expanded",
        "availability": "native",
        "kindAccessor": "heatmapFourWeekExpanded",
        "family": "systemMedium",
        "rangeWeeks": 4,
        "headerVisible": false,
        "calendarAlignment": "calendarWeeks",
        "cellContent": "dayAndBodyParts",
        "bodyPartSeparator": "·",
        "bodyPartMaxLines": 1
      }
    },
    "variants": {
      "week": {
        "style": "detailed",
        "nativeCase": "week",
        "kindAccessor": "heatmapWeek",
        "title": "지난 7일",
        "family": "systemSmall",
        "rangeDays": 7,
        "rangeWeeks": 0,
        "rangeMonths": 0,
        "headerVisible": false,
        "headerSummary": "none",
        "calendarAlignment": "rollingDays",
        "showLeadingCalendarCells": false,
        "monthBoundaryGapSlots": 0,
        "reservedHeaderHeight": 0,
        "reservedFooterHeight": 63
      },
      "month": {
        "style": "detailed",
        "nativeCase": "month",
        "kindAccessor": "heatmapMonth",
        "title": "지난 5주",
        "family": "systemSmall",
        "rangeDays": 0,
        "rangeWeeks": 5,
        "rangeMonths": 0,
        "headerVisible": false,
        "headerSummary": "none",
        "calendarAlignment": "calendarWeeks",
        "showLeadingCalendarCells": false,
        "monthBoundaryGapSlots": 0,
        "reservedHeaderHeight": 0,
        "reservedFooterHeight": 18
      },
      "year": {
        "style": "compact",
        "nativeCase": "sixMonths",
        "kindAccessor": "heatmapSixMonths",
        "title": "지난 6개월",
        "family": "systemMedium",
        "rangeDays": 0,
        "rangeWeeks": 0,
        "rangeMonths": 6,
        "headerVisible": true,
        "headerSummary": "countTotalAverage",
        "calendarAlignment": "continuousMonthsWithBoundarySlots",
        "showLeadingCalendarCells": true,
        "monthBoundaryGapSlots": 7,
        "reservedHeaderHeight": 22,
        "reservedFooterHeight": 0
      }
    },
    "sixMonth": {
      "monthLabelSize": "{typography.sm.size}",
      "monthLabelHeight": "{typography.md.lineHeight}",
      "monthHeaderBottomGap": "{spacing.md}"
    },
    "weekFooter": {
      "statOrder": ["count", "totalDuration", "averageDuration"],
      "statLabels": ["횟수", "총 시간", "평균"],
      "recentLabel": "최근 운동",
      "emptyRecentLabel": "아직 기록 없음",
      "alwaysShowRecent": true,
      "recentLimit": 2,
      "topRowGap": "{spacing.md}",
      "statGap": "{spacing.sm}",
      "recentRowGap": "{spacing.xs}",
      "statLabelSize": "{typography.sm.size}",
      "statValueSize": "{typography.lg.size}",
      "recentLabelSize": "{typography.sm.size}",
      "recentValueSize": "{typography.md.size}",
      "recentMetaSize": "{typography.sm.size}"
    },
    "monthFooter": {
      "statOrder": ["count", "totalDuration"],
      "separator": " · ",
      "totalDurationPrefix": "총 "
    }
  },
  "lockScreen": {
    "copy": {
      "active": "운동 중",
      "completedEyebrow": "오늘 완료",
      "completedBadge": "오운완",
      "idle": "다음 운동",
      "routineRequired": "루틴 설정 필요",
      "summaryTitle": "지난 7일"
    },
    "compactCharacterLimit": 3,
    "summaryDays": 7,
    "text": {
      "inline": {
        "size": "{typography.md.size}",
        "lineHeight": "{typography.md.lineHeight}",
        "weight": "{fontWeight.bold}"
      },
      "circular": {
        "size": "{typography.lg.size}",
        "lineHeight": "{typography.lg.lineHeight}",
        "weight": "{fontWeight.bold}"
      },
      "rectangularTitle": {
        "size": "{typography.xl.size}",
        "lineHeight": "{typography.xl.lineHeight}",
        "weight": "{fontWeight.bold}"
      },
      "rectangularDetail": {
        "size": "{typography.lg.size}",
        "lineHeight": "{typography.lg.lineHeight}",
        "weight": "{fontWeight.medium}"
      },
      "summary": {
        "size": "{typography.lg.size}",
        "lineHeight": "{typography.lg.lineHeight}",
        "weight": "{fontWeight.bold}"
      }
    },
    "summary": {
      "cellSize": 18,
      "cellGap": "{spacing.sm}",
      "cellRadius": "{radius.cell}",
      "fontSize": "{typography.lg.size}",
      "contentGap": "{spacing.md}",
      "contentPadding": "{spacing.sm}"
    }
  }
}
